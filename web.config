<?xml version="1.0" encoding="utf-8"?>

<configuration>

<appSettings>

<add key="WSGI_HANDLER" value="dj_pizarra.wsgi.application"/>

<add key="PYTHONPATH" value="C:\proyecto_pizarra_tareas_pi2"/>

<add key="DJANGO_SETTINGS_MODULE" value="dj_pizarra.settings"/>

<add key="WSGI_LOG" value="C:\logs\wfastcgi.log"/>

</appSettings>


<system.webServer>

<handlers>

<add
name="Python FastCGI"
path="*"
verb="*"
modules="FastCgiModule"
scriptProcessor="C:\proyecto_pizarra_tareas_pi2\env\Scripts\python.exe|C:\proyecto_pizarra_tareas_pi2\env\Lib\site-packages\wfastcgi.py"
resourceType="Unspecified"
/>

</handlers>

</system.webServer>

</configuration>